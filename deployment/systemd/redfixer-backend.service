[Unit]
Description=RedFixer Backend API
Documentation=https://github.com/jsherman999/RedFixer_claudecode_opus_superpowers
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=redfixer
Group=redfixer
WorkingDirectory=/opt/redfixer/backend
Environment="PATH=/opt/redfixer/backend/.venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="REDFIXER_CONFIG=/etc/redfixer/config.yaml"
ExecStart=/opt/redfixer/backend/.venv/bin/uvicorn redfixer.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=10s

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/redfixer/data

# Resource limits
LimitNOFILE=65536
MemoryMax=2G
CPUQuota=200%

[Install]
WantedBy=multi-user.target
