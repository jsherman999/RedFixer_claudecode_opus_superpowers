[Unit]
Description=RedFixer Podman Pod
Documentation=https://github.com/jsherman999/RedFixer_claudecode_opus_superpowers
Wants=network-online.target
After=network-online.target
RequiresMountsFor=%t/containers

[Service]
Type=forking
Restart=on-failure
RestartSec=10s
TimeoutStartSec=300
TimeoutStopSec=70

# Create pod
ExecStartPre=/usr/bin/podman pod create --name redfixer-pod \
    --publish 8000:8000 \
    --publish 8080:8080 \
    --replace

# Start backend container
ExecStartPre=/usr/bin/podman run -d \
    --name redfixer-backend \
    --pod redfixer-pod \
    --volume redfixer-data:/app/data:Z \
    --volume /etc/redfixer/config.yaml:/app/config.yaml:ro,Z \
    localhost/redfixer-backend:latest

# Start frontend container
ExecStart=/usr/bin/podman run -d \
    --name redfixer-frontend \
    --pod redfixer-pod \
    localhost/redfixer-frontend:latest

# Stop all containers and pod
ExecStop=/usr/bin/podman pod stop redfixer-pod
ExecStopPost=/usr/bin/podman pod rm -f redfixer-pod

[Install]
WantedBy=multi-user.target default.target
